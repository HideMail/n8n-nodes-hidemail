	"paths": {
		"/api/v1/sanctum/token": {
			"post": {
				"summary": "Create a token.",
				"operationId": "createAToken",
				"description": "This endpoint lets you create a permanent token. When the account has\ntwo-factor authentication enabled and the client sends\n`two_factor_supported: true`, it returns `409` with a challenge to\nexchange at `POST /api/v1/sanctum/token/two-factor`.",
				"parameters": [],
				"responses": {
					"200": {
						"description": "",
						"content": {
							"application/json": {
								"schema": {
									"oneOf": [
										{
											"description": "Two-factor authentication off",
											"type": "object",
											"example": {
												"token": "1a2b3c..."
											},
											"properties": {
												"token": {
													"type": "string",
													"example": "1a2b3c..."
												}
											}
										},
										{
											"description": "Legacy client during the grace window",
											"type": "object",
											"example": {
												"token": "1a2b3c...",
												"warnings": [
													{
														"code": "two_factor_client_upgrade_required",
														"message": "This app cannot ask for your two-factor authentication code. Update it before Oct 12, 2026, when signing in from this version will stop working.",
														"enforced_at": "2026-10-12"
													}
												]
											},
											"properties": {
												"token": {
													"type": "string",
													"example": "1a2b3c..."
												},
												"warnings": {
													"type": "array",
													"example": [
														{
															"code": "two_factor_client_upgrade_required",
															"message": "This app cannot ask for your two-factor authentication code. Update it before Oct 12, 2026, when signing in from this version will stop working.",
															"enforced_at": "2026-10-12"
														}
													],
													"items": {
														"type": "object",
														"properties": {
															"code": {
																"type": "string",
																"example": "two_factor_client_upgrade_required"
															},
															"message": {
																"type": "string",
																"example": "This app cannot ask for your two-factor authentication code. Update it before Oct 12, 2026, when signing in from this version will stop working."
															},
															"enforced_at": {
																"type": "string",
																"example": "2026-10-12"
															}
														}
													}
												}
											}
										}
									]
								}
							}
						}
					},
					"403": {
						"description": "Legacy client after the cutover",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"example": {
										"error": "two_factor_client_upgrade_required",
										"message": "Two-factor authentication is enabled on this account and this app cannot ask for your code. Update the app to sign in."
									},
									"properties": {
										"error": {
											"type": "string",
											"example": "two_factor_client_upgrade_required"
										},
										"message": {
											"type": "string",
											"example": "Two-factor authentication is enabled on this account and this app cannot ask for your code. Update the app to sign in."
										}
									}
								}
							}
						}
					},
					"409": {
						"description": "Two-factor challenge required",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"example": {
										"two_factor_required": true,
										"challenge": "3f9c...64 chars",
										"expires_in": 300,
										"methods": [
											"totp",
											"recovery_code"
										]
									},
									"properties": {
										"two_factor_required": {
											"type": "boolean",
											"example": true
										},
										"challenge": {
											"type": "string",
											"example": "3f9c...64 chars"
										},
										"expires_in": {
											"type": "integer",
											"example": 300
										},
										"methods": {
											"type": "array",
											"example": [
												"totp",
												"recovery_code"
											],
											"items": {
												"type": "string"
											}
										}
									}
								}
							}
						}
					},
					"422": {
						"description": "Wrong credentials",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"example": {
										"message": "The provided credentials are incorrect.",
										"errors": {
											"email": [
												"The provided credentials are incorrect."
											]
										}
									},
									"properties": {
										"message": {
											"type": "string",
											"example": "The provided credentials are incorrect."
										},
										"errors": {
											"type": "object",
											"properties": {
												"email": {
													"type": "array",
													"example": [
														"The provided credentials are incorrect."
													],
													"items": {
														"type": "string"
													}
												}
											}
										}
									}
								}
							}
						}
					}
				},
				"tags": [
					"Endpoints"
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"email": {
										"type": "string",
										"description": "Email.",
										"example": "hi@example.com"
									},
									"password": {
										"type": "string",
										"description": "Password.",
										"example": "password"
									},
									"device_name": {
										"type": "string",
										"description": "Device Name.",
										"example": "Raycast"
									},
									"two_factor_supported": {
										"type": "boolean",
										"description": "Declares that the client can complete a two-factor challenge. Defaults to false.",
										"example": true
									}
								},
								"required": [
									"email",
									"password",
									"device_name"
								]
							}
						}
					}
				},
				"security": []
			}
		},
		"/api/v1/sanctum/token/two-factor": {
			"post": {
				"summary": "Complete a two-factor challenge.",
				"operationId": "completeATwoFactorChallenge",
				"description": "Exchanges the `challenge` returned by a `409` from `POST /api/v1/sanctum/token`\nfor a permanent token. Send either a six-digit `code` from the authenticator\napp or one `recovery_code`. A challenge is single-use, expires after five\nminutes, and is burned after five wrong codes.\n\nThe `two_factor_too_many_attempts` 429 below burns the challenge, so the\nclient must sign in with the password again to get a new one. This is\ndistinct from the route's own rate limiter, whose 429 has a plain\n`{\"message\", \"status\": 429}` body (see `App\\Exceptions\\Handler::handleApiException`)\nand does not burn the challenge.",
				"parameters": [],
				"responses": {
					"200": {
						"description": "Verified",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"example": {
										"token": "1a2b3c..."
									},
									"properties": {
										"token": {
											"type": "string",
											"example": "1a2b3c..."
										}
									}
								}
							}
						}
					},
					"410": {
						"description": "Challenge unknown, expired or burned",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"example": {
										"error": "two_factor_challenge_expired",
										"message": "This sign-in attempt has expired. Sign in with your password again."
									},
									"properties": {
										"error": {
											"type": "string",
											"example": "two_factor_challenge_expired"
										},
										"message": {
											"type": "string",
											"example": "This sign-in attempt has expired. Sign in with your password again."
										}
									}
								}
							}
						}
					},
					"422": {
						"description": "Wrong code",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"example": {
										"message": "The provided two factor authentication code was invalid.",
										"errors": {
											"code": [
												"The provided two factor authentication code was invalid."
											]
										},
										"attempts_remaining": 3
									},
									"properties": {
										"message": {
											"type": "string",
											"example": "The provided two factor authentication code was invalid."
										},
										"errors": {
											"type": "object",
											"properties": {
												"code": {
													"type": "array",
													"example": [
														"The provided two factor authentication code was invalid."
													],
													"items": {
														"type": "string"
													}
												}
											}
										},
										"attempts_remaining": {
											"type": "integer",
											"example": 3
										}
									}
								}
							}
						}
					},
					"429": {
						"description": "",
						"content": {
							"application/json": {
								"schema": {
									"oneOf": [
										{
											"description": "Too many wrong codes for this account",
											"type": "object",
											"example": {
												"error": "two_factor_too_many_attempts",
												"message": "Too many incorrect codes. Try again later.",
												"retry_after": 900
											},
											"properties": {
												"error": {
													"type": "string",
													"example": "two_factor_too_many_attempts"
												},
												"message": {
													"type": "string",
													"example": "Too many incorrect codes. Try again later."
												},
												"retry_after": {
													"type": "integer",
													"example": 900
												}
											}
										},
										{
											"description": "Another request for this challenge or account is in flight",
											"type": "object",
											"example": {
												"error": "two_factor_busy",
												"message": "Another sign-in attempt is in progress. Try again in a moment."
											},
											"properties": {
												"error": {
													"type": "string",
													"example": "two_factor_busy"
												},
												"message": {
													"type": "string",
													"example": "Another sign-in attempt is in progress. Try again in a moment."
												}
											}
										}
									]
								}
							}
						}
					}
				},
				"tags": [
					"Endpoints"
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"challenge": {
										"type": "string",
										"description": "The challenge from the 409 response.",
										"example": "3f9c..."
									},
									"device_name": {
										"type": "string",
										"description": "Device Name. This is validated but not used to\n name the token: the device name recorded on the token is the one sent with the original\n `POST /api/v1/sanctum/token` request that issued this challenge.",
										"example": "Raycast"
									},
									"code": {
										"type": "string",
										"description": "Six-digit authenticator code. Required unless recovery_code is present.",
										"example": "123456",
										"nullable": true
									},
									"recovery_code": {
										"type": "string",
										"description": "A recovery code. Required unless code is present.",
										"example": "abcde12345-fghij67890",
										"nullable": true
									}
								},
								"required": [
									"challenge",
									"device_name"
								]
							}
						}
					}
				},
				"security": []
			}
		},
